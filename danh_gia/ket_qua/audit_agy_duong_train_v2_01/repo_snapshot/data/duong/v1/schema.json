{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DanhMucDuongV1Schema",
  "description": "JSON Schema xác thực danh mục tên đường có nguồn chứng thực (v1) cho bài toán chuẩn hóa địa chỉ.",
  "type": "object",
  "definitions": {
    "ConfirmedStreetRecord": {
      "type": "object",
      "required": [
        "id",
        "canonical_name",
        "road_type",
        "ma_tinh",
        "ten_tinh",
        "administrative_era",
        "quan_huyen_list",
        "aliases",
        "source_id",
        "source_type",
        "source_url",
        "source_sha256",
        "status",
        "verification_note",
        "unaccented_key",
        "collapsed_key",
        "initials_key"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^STR_[0-9]{5}$",
          "description": "Mã định danh duy nhất của bản ghi đường phố"
        },
        "canonical_name": {
          "type": "string",
          "minLength": 1,
          "description": "Tên đường chuẩn tắc có dấu"
        },
        "road_type": {
          "type": "string",
          "enum": ["Đường", "Phố", "Quốc lộ", "Đại lộ", "Xa lộ", "Trục đường", "Tỉnh lộ"],
          "description": "Phân loại đường giao thông"
        },
        "ma_tinh": {
          "type": "string",
          "pattern": "^[0-9]{2}$",
          "description": "Mã tỉnh 2 chữ số theo danh mục hành chính"
        },
        "ten_tinh": {
          "type": "string",
          "minLength": 1,
          "description": "Tên tỉnh/thành phố tương ứng"
        },
        "administrative_era": {
          "type": "string",
          "enum": ["hien_hanh", "moi_2025", "cu_2024"],
          "description": "Mốc thời kỳ hành chính của mã tỉnh"
        },
        "quan_huyen_list": {
          "type": "string",
          "description": "Danh sách quận huyện tuyến đường đi qua"
        },
        "aliases": {
          "type": "string",
          "description": "Bí danh, tên cũ lịch sử, tên viết tắt chính thức phân tách bằng chấm phẩy"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "description": "Tên tệp bằng chứng trong thư mục sources/"
        },
        "source_type": {
          "type": "string",
          "enum": ["van_ban_quy_pham", "cong_thong_tin_chinh_phu", "cong_dong_osm"],
          "description": "Loại hình tài liệu kiểm chứng"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "Đường dẫn tham chiếu trực tiếp đến tài liệu gốc"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Mã băm SHA-256 của tệp nguồn chứng thực"
        },
        "status": {
          "type": "string",
          "enum": ["confirmed"],
          "description": "Trạng thái xác thực của bản ghi"
        },
        "verification_note": {
          "type": "string",
          "description": "Ghi chú quá trình đối soát và xác minh"
        },
        "unaccented_key": {
          "type": "string",
          "description": "Khóa kỹ thuật bỏ dấu tiếng Việt, viết thường"
        },
        "collapsed_key": {
          "type": "string",
          "description": "Khóa kỹ thuật bỏ dấu, viết liền không khoảng trắng"
        },
        "initials_key": {
          "type": "string",
          "description": "Khóa kỹ thuật ghép các chữ cái đầu tiên của từng từ"
        }
      }
    },
    "PendingRejectedRecord": {
      "type": "object",
      "required": [
        "id",
        "raw_input",
        "status",
        "rejection_reason",
        "legal_source",
        "administrative_era",
        "source_id",
        "source_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PR_[0-9]{5}$"
        },
        "raw_input": {
          "type": "string"
        },
        "candidate_canonical_name": {
          "type": "string"
        },
        "candidate_road_type": {
          "type": "string"
        },
        "ma_tinh": {
          "type": "string"
        },
        "ten_tinh": {
          "type": "string"
        },
        "quan_huyen": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "rejected"]
        },
        "rejection_reason": {
          "type": "string"
        },
        "legal_source": {
          "type": "string"
        },
        "administrative_era": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
